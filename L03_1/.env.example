# Central Weather Administration (CWA) API Authorization Key
# 取得方式：至 https://opendata.cwa.gov.tw/ 註冊並複製個人 API 授權碼
CWA_API_KEY=CWA-YOUR-API-KEY-HERE

# PostgreSQL Database Connection URL (Vercel Postgres, Neon, Supabase, Railway)
# 連線字串範例：postgres://username:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
