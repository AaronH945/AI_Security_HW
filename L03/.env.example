# Central Weather Administration Open Data API Authorization Key
# 取得方式：至「氣象資料開放平臺」(https://opendata.cwa.gov.tw/) 註冊並取得授權碼
CWA_API_KEY=CWA-YOUR-API-KEY-HERE

# PostgreSQL Database Connection URL
# 支援 Vercel Postgres, Neon, Supabase, Railway, 或本機/自架 PostgreSQL
POSTGRES_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# (選填) Vercel Cron 安全驗證金鑰
CRON_SECRET=your-random-cron-secret
